# FVM
.fvm/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Claude Code local session state — не относится к проекту
.claude/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android related — локальные пути к SDK и сгенерированные файлы
**/android/local.properties
**/android/.gradle/
**/android/captures/
**/android/**/GeneratedPluginRegistrant.java

# iOS/Xcode related — сгенерированные файлы, локальные пути и скачанные
# зависимости, их не коммитим (Pods пересоздаются через `pod install`)
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Pods/
**/ios/.symlinks/
ios/build/
ios/Flutter/SourcePackages/

# macOS
**/macos/Flutter/ephemeral/
**/macos/Pods/
macos/build/

# Xcode user-specific / DerivedData
**/*.xcuserstate
**/xcuserdata/
**/DerivedData/
